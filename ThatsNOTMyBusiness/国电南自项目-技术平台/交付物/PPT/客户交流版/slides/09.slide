<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>02 改成什么样</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.25 }}>档位越高，代价越陡</Text>
        <Text style={{ fontSize: 16, color: '#3D4C63' }}>每升一档，多出来的不是软件许可，是资源、实例台账与运维人力。</Text>

        <Box style={{ flexDirection: 'row', gap: 20, marginTop: 26, alignItems: 'stretch' }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 12, padding: 28, background: '#F2F5F9' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7A8699' }}>L0</Text>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#3D4C63', lineHeight: 1.1 }}>1.0×</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>资源当量</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 6, marginBottom: 6 }} />
                <Text style={{ fontSize: 16, color: '#3D4C63' }}>开通 &lt; 5 min</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>仅非生产，风险最高</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 4 }} />
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#7A8699' }}>适用：仅演示与压测，不承载业务</Text>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 12, padding: 28, background: '#1F3864' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>L1</Text>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.1 }}>1.0–1.3×</Text>
                <Text style={{ fontSize: 14, color: '#C9D4E4' }}>资源当量　·　默认档</Text>
                <Box style={{ height: 1, background: '#3A5480', marginTop: 6, marginBottom: 6 }} />
                <Text style={{ fontSize: 16, color: '#FFFFFF' }}>开通 ≤ 10 min</Text>
                <Text style={{ fontSize: 14, color: '#C9D4E4' }}>约 80% 的二级租户落 L1</Text>
                <Box style={{ height: 1, background: '#3A5480', marginTop: 4 }} />
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>适用：内部单位、非涉敏业务</Text>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 12, padding: 28, background: '#F2F5F9' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2E6DA4' }}>L2</Text>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.1 }}>2.5–3.0×</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>资源当量</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 6, marginBottom: 6 }} />
                <Text style={{ fontSize: 16, color: '#3D4C63' }}>开通 0.5–2 个工作日</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>多一套实例与节点池台账</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 4 }} />
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3D4C63' }}>适用：外部客户、涉敏数据</Text>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 12, padding: 28, background: '#F2F5F9' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F3864' }}>L3</Text>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.1 }}>5.0–8.0×</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>资源当量</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 6, marginBottom: 6 }} />
                <Text style={{ fontSize: 16, color: '#3D4C63' }}>开通 1–4 周（含加固）</Text>
                <Text style={{ fontSize: 14, color: '#7A8699' }}>等于自建一套集群</Text>
                <Box style={{ height: 1, background: '#D9DEE7', marginTop: 4 }} />
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1F3864' }}>适用：外部主体、强监管业务</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Box style={{ flexDirection: 'row', background: '#1F3864', padding: 16, gap: 12 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>结论</Text>
            <Text style={{ fontSize: 16, color: '#FFFFFF' }}>档位是成本决策，不是技术偏好。能落 L1 就不要落 L2，能落 L2 就不要动 L3——省下的钱投控制面与测试。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>当量为相对资源占用与人力投入的经验估算，仅用于横向比较；L0 = 1.0</Text>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>09 / 20</Text>
        </Box>
    </Box>
</Slide>
