<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>02 改成什么样</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.25 }}>分两类看信任，不看数量</Text>
        <Text style={{ fontSize: 16, color: '#3D4C63' }}>Namespace 是配额与命名边界，不是安全边界。判据只有一条：这个租户出了事，能不能波及别人。</Text>

        <Table
            style={{ width: '100%', height: 340, marginTop: 10 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#3D4C63' }}
            defaultCellStyle={{ border: { bottom: { width: 1, color: '#D9DEE7' } }, padding: 11 }}
            cells={[
                [
                    { text: '维度', textStyle: { fontSize: 15, bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#3D4C63' } } },
                    { text: 'A 类｜内部单位、非涉敏　→ 共享集群', textStyle: { fontSize: 15, bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1F3864' } } },
                    { text: 'B 类｜外部客户、涉敏或三级　→ 独立边界', textStyle: { fontSize: 15, bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#B3261E' } } },
                ],
                ['隔离载体', 'Namespace + Capsule Tenant，共享节点池', 'vCluster 或独立集群，配独立中间件实例'],
                ['集群级可见', '不可见 Node / CRD / Operator，不可自建控制器', '租户自管 CRD 与 Operator，控制面彼此不可见'],
                ['升级节奏', '随平台统一升级，无独立窗口', '独立升级窗口，允许滞后一个平台版本'],
                ['故障影响', '同集群邻居会受波及，须靠配额与限流兜底', '故障域隔离，互不影响'],
                ['安全补偿', 'RBAC + NetworkPolicy + ResourceQuota + PSA restricted', '边界内仍执行同一套四道控制，防止内层失守'],
                ['成本当量', { text: '1.0–1.3×', textStyle: { bold: true, color: '#1F3864' } }, { text: '2.5–8.0×', textStyle: { bold: true, color: '#B3261E' } }],
            ]}
        />
    </Box>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Box style={{ flexDirection: 'row', background: '#1F3864', padding: 16, gap: 12 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>结论</Text>
            <Text style={{ fontSize: 16, color: '#FFFFFF' }}>四道控制是“共享前提下仍成立”的底线；跨过这条线的租户，必须换隔离载体，而不是加配置。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>依据 [C-1] [J-01] [J-02]</Text>
        </Box>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>A / B 分类由第 10 页打分台账判定，此处只给载体差异</Text>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>13 / 21</Text>
        </Box>
    </Box>
</Slide>
