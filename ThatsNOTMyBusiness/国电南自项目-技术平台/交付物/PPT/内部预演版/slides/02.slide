<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>摘要</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.25 }}>一页看懂：一条红线、四档隔离、三期落地</Text>
        <Text style={{ fontSize: 16, color: '#3D4C63' }}>先看三组数——落在哪、代价多少、要投多少；下面四条是展开。</Text>

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 10 }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 2, padding: 20, background: '#1F3864' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.1 }}>约 80%</Text>
                <Text style={{ fontSize: 15, color: '#C9D4E4' }}>二级租户落 L1</Text>
                <Text style={{ fontSize: 12, color: '#8FA3BF' }}>最便宜、也够用的一档</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 2, padding: 20, background: '#F2F5F9' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.1 }}>45%–55%</Text>
                <Text style={{ fontSize: 15, color: '#3D4C63' }}>资源当量</Text>
                <Text style={{ fontSize: 12, color: '#7A8699' }}>以全量落 L2 为 100%</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 2, padding: 20, background: '#F2F5F9' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.1 }}>约 109.5</Text>
                <Text style={{ fontSize: 15, color: '#3D4C63' }}>人月（三期合计）</Text>
                <Text style={{ fontSize: 12, color: '#7A8699' }}>43.5 + 34.0 + 32.0</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'column', marginTop: 8 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16, paddingTop: 14, paddingBottom: 14, borderBottom: '1px solid #D9DEE7' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F3864', width: 36 }}>01</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3864' }}>红线：全部资源只落安全Ⅲ区</Text>
                    <Text style={{ fontSize: 14, color: '#3D4C63' }}>L3 独立集群也不跨区；生产控制区数据单向进入，不回写控制指令</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16, paddingTop: 14, paddingBottom: 14, borderBottom: '1px solid #D9DEE7' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F3864', width: 36 }}>02</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3864' }}>分档：L0–L3 四维打分定档</Text>
                    <Text style={{ fontSize: 14, color: '#3D4C63' }}>业务、数据、监管、SLA 各 1–5 分，T=4–20；另设 5 条一票否决</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16, paddingTop: 14, paddingBottom: 14, borderBottom: '1px solid #D9DEE7' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F3864', width: 36 }}>03</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3864' }}>成本：不做一刀切</Text>
                    <Text style={{ fontSize: 14, color: '#3D4C63' }}>约 80% 的二级租户落 L1，资源当量是全 L2 方案的 45%–55%</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 16, paddingTop: 14 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F3864', width: 36 }}>04</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F3864' }}>落地：三期约 109.5 人月，测试不砍</Text>
                    <Text style={{ fontSize: 14, color: '#3D4C63' }}>P0 43.5 / P1 34.0 / P2 32.0；测试约占 24%，原型先跑通 S2</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>集团级多租户技术平台架构设计方案 · v0.1 · 内部预演</Text>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>02 / 13</Text>
    </Box>
</Slide>
