<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>02 改成什么样</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.25 }}>四层架构，改造重心在控制面</Text>
        <Text style={{ fontSize: 16, color: '#3D4C63' }}>层间只走四条契约，不允许跨层直连；控制面出错影响全平台，数据面出错只影响一个租户。</Text>

        <svg width={1160} height={420} viewBox='0 0 1160 420'>
            <rect x='0' y='0' width='1160' height='72' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='12' y='30' fontSize='14' fontWeight='bold' fill='#1F3864' fontFamily='Microsoft YaHei'>L4</text>
            <text x='12' y='50' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>应用与门户</text>
            <rect x='124' y='12' width='240' height='48' fill='#F2F5F9' /><text x='140' y='42' fontSize='15' fill='#3D4C63' fontFamily='Microsoft YaHei'>统一门户</text>
            <rect x='374' y='12' width='240' height='48' fill='#F2F5F9' /><text x='390' y='42' fontSize='15' fill='#3D4C63' fontFamily='Microsoft YaHei'>统一待办</text>
            <rect x='624' y='12' width='240' height='48' fill='#F2F5F9' /><text x='640' y='42' fontSize='15' fill='#3D4C63' fontFamily='Microsoft YaHei'>租户自建应用</text>
            <rect x='874' y='12' width='276' height='48' fill='#F2F5F9' /><text x='890' y='42' fontSize='15' fill='#3D4C63' fontFamily='Microsoft YaHei'>外部厂商应用</text>

            <text x='130' y='92' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>↓ 仅经网关调用，禁止应用直连服务实例</text>

            <rect x='0' y='102' width='1160' height='78' fill='#F2F5F9' stroke='#D9DEE7' strokeWidth='1' />
            <text x='12' y='134' fontSize='14' fontWeight='bold' fill='#1F3864' fontFamily='Microsoft YaHei'>L3</text>
            <text x='12' y='154' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>平台服务</text>
            <rect x='124' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='134' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>应用构建</text><text x='134' y='156' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>必改</text>
            <rect x='272' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='282' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>应用集成</text><text x='282' y='156' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>必改</text>
            <rect x='420' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='430' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>数据集成</text><text x='430' y='156' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>必改</text>
            <rect x='568' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='578' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>时序数据</text><text x='578' y='156' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>轻改</text>
            <rect x='716' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='726' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>大数据</text><text x='726' y='156' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>不动</text>
            <rect x='864' y='114' width='140' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='874' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>大模型</text><text x='874' y='156' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>不动</text>
            <rect x='1012' y='114' width='138' height='54' fill='#FFFFFF' stroke='#D9DEE7' strokeWidth='1' />
            <text x='1022' y='136' fontSize='14' fill='#1F3864' fontFamily='Microsoft YaHei'>中间件</text><text x='1022' y='156' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>轻改</text>

            <text x='130' y='198' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>↓ 租户上下文注入（服务不信任调用方自报）　↑ 状态上报与计量流水</text>

            <rect x='0' y='208' width='1160' height='78' fill='#F2F5F9' stroke='#1F3864' strokeWidth='1.5' />
            <text x='12' y='240' fontSize='14' fontWeight='bold' fill='#1F3864' fontFamily='Microsoft YaHei'>L2</text>
            <text x='12' y='260' fontSize='13' fill='#1F3864' fontFamily='Microsoft YaHei'>管控面</text>
            <rect x='124' y='220' width='160' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='136' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>租户管理</text><text x='136' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>
            <rect x='294' y='220' width='160' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='306' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>身份联邦</text><text x='306' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>
            <rect x='464' y='220' width='160' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='476' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>配额与准入</text><text x='476' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>
            <rect x='634' y='220' width='160' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='646' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>开通编排</text><text x='646' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>
            <rect x='804' y='220' width='160' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='816' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>计量采集</text><text x='816' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>
            <rect x='974' y='220' width='176' height='54' fill='#FFFFFF' stroke='#2E6DA4' strokeWidth='1' />
            <text x='986' y='242' fontSize='15' fill='#1F3864' fontFamily='Microsoft YaHei'>审计与合规</text><text x='986' y='262' fontSize='12' fill='#7A8699' fontFamily='Microsoft YaHei'>事实源</text>

            <text x='130' y='304' fontSize='13' fill='#2E6DA4' fontFamily='Microsoft YaHei'>↓ 配额下发与准入拦截（声明式下发，写入前拦截）</text>

            <rect x='0' y='314' width='1160' height='78' fill='#FAFBFC' stroke='#D9DEE7' strokeWidth='1' />
            <text x='12' y='346' fontSize='14' fontWeight='bold' fill='#1F3864' fontFamily='Microsoft YaHei'>L1</text>
            <text x='12' y='366' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>基础设施</text>
            <text x='124' y='343' fontSize='15' fill='#3D4C63' fontFamily='Microsoft YaHei'>信创服务器（鲲鹏 / 飞腾 / 海光）　·　虚拟化或裸金属　·　容器运行时　·　块/对象/文件存储　·　VPC / 负载均衡 / 防火墙</text>
            <text x='124' y='371' fontSize='14' fill='#7A8699' fontFamily='Microsoft YaHei'>承载客户既有“资源管理运行平台（基于 K8s 增强）”，本方案不替换，只在其上加租户治理层</text>

            <text x='124' y='410' fontSize='13' fill='#7A8699' fontFamily='Microsoft YaHei'>注：L3 各板块角标为本期改造强度；L1 数据面已是独立实例，本期不动</text>
        </svg>
    </Box>

    <Box style={{ flexDirection: 'column', gap: 6 }}>
        <Box style={{ flexDirection: 'row', justifyContent: 'flex-end' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>依据 [G-05]</Text>
        </Box>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>集团级多租户技术平台架构设计方案 · v0.1</Text>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>06 / 13</Text>
        </Box>
    </Box>
