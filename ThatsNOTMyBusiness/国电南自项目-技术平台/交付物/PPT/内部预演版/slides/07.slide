<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', display: 'flex', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 14, color: '#7A8699' }}>02 改成什么样</Text>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F3864', lineHeight: 1.25 }}>四档台阶，每上一档代价翻倍</Text>
        <Text style={{ fontSize: 16, color: '#3D4C63' }}>多出来的不是软件许可，是资源、实例台账与运维人力——所以档位要省着用。</Text>

        <Table
            style={{ width: '100%', height: 362, marginTop: 8 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#3D4C63' }}
            defaultCellStyle={{ border: { bottom: { width: 1, color: '#D9DEE7' } }, padding: 13 }}
            cells={[
                [
                    { text: '档位', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#3D4C63' } } },
                    { text: '隔离载体', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1F3864' } } },
                    { text: '资源当量', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1F3864' } } },
                    { text: '开通时长', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1F3864' } } },
                    { text: '典型适用', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1F3864' } } },
                ],
                [{ text: 'L0', textStyle: { bold: true, color: '#7A8699' } }, '共享命名空间，几乎不隔离', '1.0×', '< 5 min', '仅演示与压测，不承载业务'],
                [{ text: 'L1', textStyle: { bold: true, color: '#1F3864' }, cellStyle: { background: { color: '#EEF3F9' } } }, { text: 'Namespace + 配额 + 网络策略', cellStyle: { background: { color: '#EEF3F9' } } }, { text: '1.0–1.3×', textStyle: { bold: true, color: '#1F3864' }, cellStyle: { background: { color: '#EEF3F9' } } }, { text: '≤ 10 min', cellStyle: { background: { color: '#EEF3F9' } } }, { text: '内部单位、非涉敏业务', cellStyle: { background: { color: '#EEF3F9' } } }],
                [{ text: 'L2', textStyle: { bold: true, color: '#2E6DA4' } }, '独立数据库与中间件实例', { text: '2.5–3.0×', textStyle: { bold: true, color: '#2E6DA4' } }, '0.5–2 个工作日', '外部客户、涉敏数据'],
                [{ text: 'L3', textStyle: { bold: true, color: '#B3261E' } }, '独立集群 + 独立资源池 + 独立控制面', { text: '5.0–8.0×', textStyle: { bold: true, color: '#B3261E' } }, '1–4 周（含加固）', '外部主体、强监管业务'],
            ]}
        />
    </Box>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
        <Box style={{ flexDirection: 'row', background: '#1F3864', padding: 16, gap: 12 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>结论</Text>
            <Text style={{ fontSize: 16, color: '#FFFFFF' }}>L1 覆盖约 80% 的二级租户，L3 目标 ≤ 5 个集群——超出就说明判据没守住。</Text>
        </Box>
        <Box style={{ flexDirection: 'row', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>当量为相对资源占用与人力投入的经验估算，仅用于横向比较；L0 = 1.0</Text>
            <Text style={{ fontSize: 14, color: '#7A8699' }}>07 / 12</Text>
        </Box>
    </Box>
</Slide>
