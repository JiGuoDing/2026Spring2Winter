{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tasks.schema.json",
  "title": "tasks",
  "description": "取数题库。真值分三层：数值层（执行结果）、口径层（metric 证据）、主张层（claim→chunk）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "question", "difficulty", "gold_sql", "snapshot", "answer_shape",
    "expected_columns", "truth", "metric_refs", "permission", "time_window"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^q[0-9]{3}$" },
    "question": { "type": "string", "minLength": 4 },
    "difficulty": { "enum": ["single_table", "join", "nested_agg"] },
    "gold_sql": { "type": "string", "minLength": 10 },
    "snapshot": { "enum": ["v0", "v1", "v2"] },
    "answer_shape": { "enum": ["scalar", "table"] },
    "expected_columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "claims", "evidence"],
      "properties": {
        "value": {
          "description": "gold_sql 在指定 snapshot 上的执行结果（规范化后）",
          "oneOf": [{ "type": "number" }, { "type": "array" }, { "type": "null" }]
        },
        "value_hash": { "type": "string" },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidence"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["doc_id", "chunk_id", "version"],
                  "properties": {
                    "doc_id": { "type": "string" },
                    "chunk_id": { "type": "string" },
                    "version": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["doc_id", "chunk_id", "version"],
            "properties": {
              "doc_id": { "type": "string" },
              "chunk_id": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "metric_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^metric_[0-9]{3}$" }
    },
    "permission": { "enum": ["public", "staff", "restricted"] },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    }
  }
}
