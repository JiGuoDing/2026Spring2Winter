{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request_stream.schema.json",
  "title": "request_stream",
  "description": "单轮用户请求流。query_emb 允许为 null（未跑 embedding），ans_emb 同名规则见 contracts/field_dictionary.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "req_id", "timestamp", "query_text", "query_emb", "plan_id", "act_key",
    "gold_doc_ids", "gold_fact_spans", "domain", "permission", "snapshot", "obj_types"
  ],
  "properties": {
    "req_id": { "type": "string", "pattern": "^r[0-9]{6}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "query_text": { "type": "string", "minLength": 1 },
    "query_emb": {
      "oneOf": [
        { "type": "array", "items": { "type": "number" }, "minItems": 8 },
        { "type": "null" }
      ]
    },
    "plan_id": { "type": ["string", "null"], "pattern": "^plan_[0-9]{2}$" },
    "act_key": { "type": ["string", "null"], "pattern": "^act_[a-z0-9_]+$" },
    "gold_doc_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "gold_fact_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "chunk_id"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "chunk_id": { "type": "string" }
        }
      }
    },
    "domain": { "type": "string", "minLength": 1 },
    "permission": { "enum": ["public", "staff", "restricted"] },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "as_of"],
      "properties": {
        "index": { "enum": ["v0", "v1", "v2"] },
        "as_of": { "type": "string", "format": "date-time" }
      }
    },
    "obj_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["resp", "rag", "act", "plan"] }
    }
  }
}
