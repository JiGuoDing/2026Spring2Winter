# 模型标定凭据模板
#
# 用法：把本文件复制为 dataset/.env，填入真实值，然后运行
#   python dataset/tools/run_calibration_from_env.py --dry-run
#   python dataset/tools/run_calibration_from_env.py
# 跑完后请删除 dataset/.env，并按需轮换 key。
#
# 安全约定：本文件（dataset/.env）只在本机读取，脚本不会打印、不会写入任何数据集产物或 MANIFEST。
#           不要把真实 key 提交到任何仓库，也不要贴进聊天窗口。

# OpenAI 兼容基址。示例：
#   本地 Ollama: http://127.0.0.1:11434/v1
#   本地 vLLM:   http://127.0.0.1:8000/v1
#   云服务:      https://api.example.com/v1
LLM_BASE_URL=

# 访问密钥。目标为 localhost/127.0.0.1 时可留空。
LLM_API_KEY=

# 两个成本档案各自对应的模型名（模型名不是机密，可只填一个）。
# local-small-7b：小模型 / 本地模型，对齐成本表里的 local-small-7b 行
LLM_MODEL_SMALL=

# api-large-placeholder：大模型 / 远程模型，对齐 api-large-placeholder 行
LLM_MODEL_LARGE=
