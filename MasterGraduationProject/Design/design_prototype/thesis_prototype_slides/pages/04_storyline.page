pageType: content
background:
  type: solid
  color: "$bg"
notes: 核心一页：一句话讲清研究故事——用 Flink 键控状态承载语义记忆，建立「预测→联合配置→短路与状态维护」闭环，在双约束下最小化资源。下方明确 SLO 的两个组成部分。
elements:
  - elementId: hdr-tag
    elementType: text
    bounds: [48, 24, 500, 16]
    content: {fontSize: 10, color: "$sub", letterSpacing: 2, wrap: false, text: 02 · 研究故事线与 SLO 定义}
  - elementId: hdr-page
    elementType: text
    bounds: [860, 24, 52, 16]
    content: {fontSize: 10, color: "$sub", align: [right, top], wrap: false, text: 04 / 12}
  - elementId: title
    elementType: text
    bounds: [48, 48, 800, 34]
    content: {style: "$pagetitle", wrap: false, text: 研究故事线：以「语义记忆」为主线的闭环}
  - elementId: title-tick
    elementType: shape
    bounds: [48, 90, 34, 3]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: lead
    elementType: text
    bounds: [48, 106, 864, 42]
    content:
      style: "$lead"
      text: 用 Flink 键控状态承载「语义记忆」，在流式推理管线上建立「预测 → 联合配置 → 推理短路与状态维护」的闭环，用最小的缓存容量与推理资源服务动态负载。
  - elementId: loop-n1
    elementType: shape
    bounds: [48, 196, 240, 66]
    shapeName: rect
    fill: {type: solid, color: "$paper"}
    border: {style: solid, width: 1.5, color: "$primary"}
  - elementId: loop-n1-t
    elementType: text
    bounds: [48, 196, 240, 66]
    content:
      align: [center, middle]
      lineHeight: 1.35
      text: |
        <p style="text-align:center"><span style="font-size:13.5px; color:$ink;"><strong>① 预测</strong></span></p>
        <p style="text-align:center"><span style="font-size:10px; color:$sub;">推理长度 · TTFT · 端到端时延 P50/P95</span></p>
  - elementId: loop-a1
    elementType: line
    bounds: [292, 228, 40, 2]
    viewBox: [40, 2]
    points: "0,1 40,1"
    arrow: [null, stealth]
    border: {style: solid, width: 1.5, color: "$sub"}
  - elementId: loop-n2
    elementType: shape
    bounds: [336, 196, 240, 66]
