  - elementId: loop-n2-t
    elementType: text
    bounds: [336, 196, 240, 66]
    content:
      align: [center, middle]
      lineHeight: 1.35
      text: |
        <p style="text-align:center"><span style="font-size:13.5px; color:$ink;"><strong>② 联合配置</strong></span></p>
        <p style="text-align:center"><span style="font-size:10px; color:$sub;">语义库缓存容量 · 推理并行度 · 批次大小</span></p>
  - elementId: loop-a2
    elementType: line
    bounds: [580, 228, 40, 2]
