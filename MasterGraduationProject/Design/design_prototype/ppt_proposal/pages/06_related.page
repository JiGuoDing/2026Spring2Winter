pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: kicker
    elementType: text
    bounds: [56, 30, 300, 14]
    content:
      style: "$kicker"
      wrap: false
      text: 02 · 相关工作
  - elementId: title
    elementType: text
    bounds: [56, 48, 848, 34]
    content:
      style: "$pageTitle"
      wrap: false
      text: 相关工作与本课题的差异化位置
  - elementId: title-rule
    elementType: shape
    bounds: [56, 92, 848, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: related-table
    elementType: table
    bounds: [56, 116, 848, 296]
    columnWidths: [0.17, 0.27, 0.32, 0.24]
    rowHeights: [0.13, 0.2175, 0.2175, 0.2175, 0.2175]
    style: "$default"
    rows:
      - - text: 工作
        - text: 核心机制
        - text: 局限（留给本课题的空白）
        - text: 对本课题的借鉴
      - - text: GPTCache 等工业语义缓存
        - text: 全局静态相似度阈值（典型 0.8）
        - text: 无错误率保证；正误命中的相似度分布高度重叠，错误率不可控
        - text: 语义准入的基本范式
      - - text: vCache（ICLR 2026）
        - text: 逐条目阈值在线学习 ＋ 用户可定义的 δ 错误率保证
        - text: 单机、单轮、静态负载；无容量与淘汰；无 SLO 与推理资源的联合优化
        - text: 正确复用概率估计 → 做贴合流处理场景的简版实现
      - - text: 小红书流式推理系统 ＋ 启明短路读
        - text: 单轮流式推理管线、轻量 ML 时延预测、频率驱动的缓存替换
        - text: 面向单轮对话，无跨轮 / 跨会话状态复用；短路读非 LLM 推理场景
        - text: 预测与缓存替换算法的改进起点；「短路」思路来源
      - - text: 本课题
          bold: true
          fill: {type: solid, color: "$softP"}
        - text: Flink 流处理层 × 语义记忆 × 双约束 SLO 联合控制
          fill: {type: solid, color: "$softP"}
        - text: ——
          fill: {type: solid, color: "$softP"}
        - text: 多轮 Agent 会话下「预测 → 配置 → 执行」闭环
          fill: {type: solid, color: "$softP"}

  - elementId: diff-bar
    elementType: shape
    bounds: [56, 436, 3, 42]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: diff-text
    elementType: text
    bounds: [72, 436, 832, 42]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.5
      align: [left, middle]
      text: |
        <p><strong>差异化锚点</strong>：现有工作都在「引擎内」或「单机」打补丁；本课题在<span style="color:$primary"><strong>流处理层</strong></span>把语义记忆当作与推理资源、SLO <strong>联合控制</strong>的可控状态。</p>

  - elementId: footer-left
    elementType: text
    bounds: [56, 512, 600, 13]
    content:
      style: "$footer"
      wrap: false
      text: 毕业设计初版方案 · 面向 SLO 的知识库缓存动态优化的流式 Agent 推理系统
  - elementId: footer-right
    elementType: text
    bounds: [856, 512, 48, 13]
    content: {style: "$footer", align: [right, top], wrap: false, text: 06 / 17}
