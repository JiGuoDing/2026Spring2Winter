    bounds: [716, 234, 44, 8]
    viewBox: [44, 8]
    points: "0,4 44,4"
    arrow: [null, stealth]
    border: {style: solid, width: 1.4, color: "$sub"}
  - elementId: pipe-sink
    elementType: shape
    bounds: [764, 214, 100, 48]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$soft"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: pipe-sink-t
    elementType: text
    bounds: [764, 214, 100, 48]
    content: {fontSize: 12, bold: true, color: "$text", align: [center, middle], text: Sink}

  - elementId: miss-label
    elementType: text
    bounds: [430, 268, 240, 13]
    content: {fontSize: 9.5, color: "$faint", wrap: false, text: 未命中 → 走完整推理路径}

  - elementId: shortcut-v1
    elementType: line
    bounds: [296, 264, 4, 52]
    viewBox: [4, 52]
    points: "2,0 2,52"
    border: {style: dash, width: 1.4, color: "$primary"}
  - elementId: shortcut-h
    elementType: line
    bounds: [296, 314, 518, 4]
    viewBox: [518, 4]
    points: "0,2 518,2"
    border: {style: dash, width: 1.4, color: "$primary"}
  - elementId: shortcut-v2
    elementType: line
    bounds: [812, 264, 4, 52]
    viewBox: [4, 52]
    points: "2,52 2,0"
