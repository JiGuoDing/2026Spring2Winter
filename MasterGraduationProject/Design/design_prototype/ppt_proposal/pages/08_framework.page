    border: {style: dash, width: 1.4, color: "$primary"}
  - elementId: shortcut-label
    elementType: text
    bounds: [400, 322, 400, 14]
    content: {fontSize: 10.5, bold: true, color: "$primary", wrap: false, text: 语义命中 → 短路 Batcher ＋ Inferencer，直接返回结果（节省 GPU）}

  - elementId: rp1-rule
    elementType: shape
    bounds: [56, 384, 264, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rp1-title
    elementType: text
    bounds: [56, 394, 264, 18]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: 点 1 · 感知｜时延预测}
  - elementId: rp1-desc
    elementType: text
    bounds: [56, 416, 264, 34]
    content: {fontSize: 10.5, color: "$sub", lineHeight: 1.4, text: 在请求到达与排队处，预测推理长度与端到端时延}
  - elementId: rp1-loc
    elementType: text
    bounds: [56, 452, 264, 14]
    content: {fontSize: 9.5, color: "$faint", wrap: false, text: 作用位置：Source 与 Batcher 前的排队区}

  - elementId: rp2-rule
    elementType: shape
    bounds: [348, 384, 264, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rp2-title
    elementType: text
    bounds: [348, 394, 264, 18]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: 点 2 · 决策｜短路与调优}
  - elementId: rp2-desc
    elementType: text
    bounds: [348, 416, 264, 34]
    content: {fontSize: 10.5, color: "$sub", lineHeight: 1.4, text: 错误率约束内短路复用；联合调优容量 / 并行度 / 批次}
  - elementId: rp2-loc
    elementType: text
    bounds: [348, 452, 264, 14]
    content: {fontSize: 9.5, color: "$faint", wrap: false, text: 作用位置：全管线（SLO 控制器）}

  - elementId: rp3-rule
    elementType: shape
    bounds: [640, 384, 264, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: rp3-title
    elementType: text
    bounds: [640, 394, 264, 18]
    content: {fontSize: 13, bold: true, color: "$text", wrap: false, text: 点 3 · 执行｜状态优化}
  - elementId: rp3-desc
    elementType: text
    bounds: [640, 416, 264, 34]
    content: {fontSize: 10.5, color: "$sub", lineHeight: 1.4, text: 缓存项双路打分替换；会话亲和性路由}
  - elementId: rp3-loc
    elementType: text
    bounds: [640, 452, 264, 14]
    content: {fontSize: 9.5, color: "$faint", wrap: false, text: 作用位置：语义记忆算子内部}

  - elementId: framework-note
    elementType: text
    bounds: [56, 482, 848, 14]
    content: {style: "$note", wrap: false, text: 基底管线 Source → StateFetcher → Batcher → Inferencer → Sink 保持不变；记忆条目存于 Operator State，随 checkpoint 容错。}

  - elementId: footer-left
    elementType: text
    bounds: [56, 512, 600, 13]
    content:
      style: "$footer"
      wrap: false
      text: 毕业设计初版方案 · 面向 SLO 的知识库缓存动态优化的流式 Agent 推理系统
  - elementId: footer-right
    elementType: text
    bounds: [856, 512, 48, 13]
    content: {style: "$footer", align: [right, top], wrap: false, text: 08 / 17}
