pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: kicker
    elementType: text
    bounds: [56, 30, 300, 14]
    content:
      style: "$kicker"
      wrap: false
      text: 03 · 研究框架
  - elementId: title
    elementType: text
    bounds: [56, 48, 848, 34]
    content:
      style: "$pageTitle"
      wrap: false
      text: 整体框架：管线零改动，只升级一个算子
  - elementId: title-rule
    elementType: shape
    bounds: [56, 92, 848, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: upgrade-note
    elementType: shape
    bounds: [206, 120, 184, 40]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
    border: {style: dash, width: 1, color: "$primary"}
  - elementId: upgrade-note-t
    elementType: text
    bounds: [212, 124, 172, 32]
    content: {fontSize: 9.5, color: "$primary", align: [center, middle], lineHeight: 1.3, text: StateFetcher 升级为「语义记忆算子」：embedding 索引 ＋ 语义检索}
  - elementId: upgrade-link
    elementType: line
    bounds: [297, 162, 2, 50]
    viewBox: [2, 50]
    points: "1,0 1,50"
    border: {style: dash, width: 1, color: "$primary"}

  - elementId: ctrl-box
    elementType: shape
    bounds: [610, 118, 254, 52]
    shapeName: rect
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: ctrl-box-t
    elementType: text
    bounds: [618, 122, 238, 44]
    content:
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p><span style="font-size:11.5px; color:$primary"><strong>SLO 控制器（点 2）</strong></span></p>
        <p><span style="font-size:9.5px; color:$sub">调优：容量 S · 并行度 p · 批次 b · 短路阈值</span></p>
  - elementId: ctrl-to-sf
    elementType: line
    bounds: [298, 162, 312, 48]
    viewBox: [312, 48]
    points: "312,0 0,48"
    curve: sharp
    arrow: [null, stealth]
    border: {style: dash, width: 1.2, color: "$primary"}
  - elementId: ctrl-to-inf
    elementType: line
    bounds: [654, 172, 76, 40]
    viewBox: [76, 40]
    points: "76,0 0,40"
    curve: sharp
    arrow: [null, stealth]
    border: {style: dash, width: 1.2, color: "$primary"}

  - elementId: pipe-source
    elementType: shape
    bounds: [56, 214, 110, 48]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$soft"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: pipe-source-t
    elementType: text
    bounds: [56, 214, 110, 48]
    content: {fontSize: 12, bold: true, color: "$text", align: [center, middle], text: Source}
  - elementId: pipe-a1
    elementType: line
    bounds: [170, 234, 44, 8]
    viewBox: [44, 8]
    points: "0,4 44,4"
    arrow: [null, stealth]
    border: {style: solid, width: 1.4, color: "$sub"}
  - elementId: pipe-sf
    elementType: shape
    bounds: [218, 214, 160, 48]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$primary"}
  - elementId: pipe-sf-t
    elementType: text
    bounds: [218, 214, 160, 48]
    content: {fontSize: 12, bold: true, color: "#FFFFFF", align: [center, middle], lineHeight: 1.25, text: 语义记忆算子<br/>（原 StateFetcher）}
  - elementId: pipe-a2
    elementType: line
    bounds: [382, 234, 44, 8]
    viewBox: [44, 8]
    points: "0,4 44,4"
    arrow: [null, stealth]
    border: {style: solid, width: 1.4, color: "$sub"}
  - elementId: pipe-batcher
    elementType: shape
    bounds: [430, 214, 110, 48]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$soft"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: pipe-batcher-t
    elementType: text
    bounds: [430, 214, 110, 48]
    content: {fontSize: 12, bold: true, color: "$text", align: [center, middle], text: Batcher}
  - elementId: pipe-a3
    elementType: line
    bounds: [544, 234, 44, 8]
    viewBox: [44, 8]
    points: "0,4 44,4"
    arrow: [null, stealth]
    border: {style: solid, width: 1.4, color: "$sub"}
  - elementId: pipe-inferencer
    elementType: shape
    bounds: [592, 214, 120, 48]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$soft"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: pipe-inferencer-t
    elementType: text
    bounds: [592, 214, 120, 48]
    content: {fontSize: 12, bold: true, color: "$text", align: [center, middle], text: Inferencer}
  - elementId: pipe-a4
