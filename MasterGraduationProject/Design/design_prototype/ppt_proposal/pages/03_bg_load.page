    viewBox: [30, 6]
    points: "0,3 30,3"
    arrow: [null, stealth]
    border: {style: solid, width: 1.2, color: "$primary"}
  - elementId: dia-b-n3
    elementType: shape
    bounds: [780, 258, 96, 34]
    shapeName: roundRect
    adjustments: [14000]
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: dia-b-n3-t
    elementType: text
    bounds: [780, 258, 96, 34]
    content: {fontSize: 11, color: "$primary", bold: true, align: [center, middle], text: 会话轮次 3}
  - elementId: dia-b-reuse
    elementType: line
    bounds: [560, 300, 268, 24]
    viewBox: [268, 24]
    points: "268,0 134,24 0,0"
    curve: smooth
    arrow: [null, stealth]
    border: {style: dash, width: 1.2, color: "$primary"}
  - elementId: dia-b-cap
    elementType: text
    bounds: [512, 330, 392, 14]
    content: {fontSize: 10, color: "$primary", wrap: false, text: 上下文逐轮累积，历史回复与知识资料可跨轮 / 跨会话复用}

  - elementId: takeaway-bar
    elementType: shape
    bounds: [56, 442, 3, 42]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: takeaway
    elementType: text
    bounds: [72, 442, 832, 42]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.5
      align: [left, middle]
      text: |
        机会在于「复用」——会话结果与知识资料都能跨轮、跨会话复用；代价是这份「状态」必须被缓存、调度与控制。

  - elementId: footer-left
    elementType: text
    bounds: [56, 512, 600, 13]
    content:
      style: "$footer"
      wrap: false
      text: 毕业设计初版方案 · 面向 SLO 的知识库缓存动态优化的流式 Agent 推理系统
  - elementId: footer-right
    elementType: text
    bounds: [856, 512, 48, 13]
    content: {style: "$footer", align: [right, top], wrap: false, text: 03 / 17}
