pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: kicker
    elementType: text
    bounds: [56, 30, 300, 14]
    content:
      style: "$kicker"
      wrap: false
      text: 03 · 研究框架
  - elementId: title
    elementType: text
    bounds: [56, 48, 848, 34]
    content:
      style: "$pageTitle"
      wrap: false
      text: 研究故事线：让「语义记忆」成为管线上可控的资源
  - elementId: title-rule
    elementType: shape
    bounds: [56, 92, 848, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  - elementId: intro
    elementType: text
    bounds: [56, 106, 848, 44]
    content:
      fontSize: 12.5
      color: "$sub"
      lineHeight: 1.5
      align: [left, top]
      text: |-
        多轮 Agent 会话把推理从「每次独立完成的一次计算」变成「跨轮、跨会话可复用的状态」。本研究用 Flink 键控状态承载这份语义记忆，在流式推理管线上建立如下闭环：

  - elementId: loop-n1
    elementType: shape
    bounds: [110, 160, 250, 66]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: loop-n1-t
    elementType: text
    bounds: [122, 168, 226, 50]
    content:
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p><span style="font-size:14px; color:$primary"><strong>① 预测（点 1）</strong></span></p>
        <p><span style="font-size:10.5px; color:$sub">推理长度 · TTFT · 端到端时延 P50 / P95</span></p>
  - elementId: loop-n2
    elementType: shape
    bounds: [600, 160, 250, 66]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: loop-n2-t
    elementType: text
    bounds: [612, 168, 226, 50]
    content:
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p><span style="font-size:14px; color:$primary"><strong>② 联合配置（点 2）</strong></span></p>
        <p><span style="font-size:10.5px; color:$sub">缓存容量 S · 并行度 p · 批次 b · 短路阈值</span></p>
  - elementId: loop-n3
    elementType: shape
    bounds: [600, 330, 250, 66]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: loop-n3-t
    elementType: text
    bounds: [612, 338, 226, 50]
    content:
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p><span style="font-size:14px; color:$primary"><strong>③ 短路与状态维护（点 2 / 3）</strong></span></p>
        <p><span style="font-size:10.5px; color:$sub">命中短路 · 缓存项替换 · 会话亲和路由</span></p>
  - elementId: loop-n4
    elementType: shape
    bounds: [110, 330, 250, 66]
    shapeName: roundRect
    adjustments: [12000]
    fill: {type: solid, color: "$softP"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: loop-n4-t
    elementType: text
    bounds: [122, 338, 226, 50]
    content:
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p><span style="font-size:14px; color:$primary"><strong>④ 观测回注</strong></span></p>
        <p><span style="font-size:10.5px; color:$sub">命中率 · 错误率 · 端到端时延 → 在线校准</span></p>

  - elementId: loop-arr1
    elementType: line
    bounds: [366, 188, 228, 10]
    viewBox: [228, 10]
    points: "0,5 228,5"
    arrow: [null, stealth]
    border: {style: solid, width: 1.5, color: "$primary"}
  - elementId: loop-arr2
    elementType: line
    bounds: [720, 232, 10, 92]
    viewBox: [10, 92]
    points: "5,0 5,92"
    arrow: [null, stealth]
    border: {style: solid, width: 1.5, color: "$primary"}
  - elementId: loop-arr3
    elementType: line
    bounds: [366, 358, 228, 10]
    viewBox: [228, 10]
    points: "228,5 0,5"
    arrow: [null, stealth]
    border: {style: solid, width: 1.5, color: "$primary"}
  - elementId: loop-arr4
    elementType: line
    bounds: [230, 232, 10, 92]
    viewBox: [10, 92]
    points: "5,92 5,0"
    arrow: [null, stealth]
    border: {style: solid, width: 1.5, color: "$primary"}

  - elementId: loop-center
    elementType: text
    bounds: [330, 236, 300, 84]
    content:
      fontSize: 14.5
      bold: true
      color: "$text"
      lineHeight: 1.55
      align: [center, middle]
      text: |
        <p style="text-align:center">目标：时延 SLO 与错误率预算双约束下，用最小的缓存容量与推理资源，服务动态负载</p>

  - elementId: loop-note
    elementType: text
    bounds: [56, 450, 848, 34]
    content:
      style: "$small"
      fontSize: 11
      align: [left, middle]
      text: |-
        闭环链：点 1 输出预测 → 点 2 据预测与观测做联合配置 → 点 3 在给定配置下执行 → 运行观测回注点 1，在线校准。

  - elementId: footer-left
    elementType: text
    bounds: [56, 512, 600, 13]
    content:
      style: "$footer"
      wrap: false
      text: 毕业设计初版方案 · 面向 SLO 的知识库缓存动态优化的流式 Agent 推理系统
  - elementId: footer-right
    elementType: text
    bounds: [856, 512, 48, 13]
    content: {style: "$footer", align: [right, top], wrap: false, text: 07 / 17}
